{
  "$id": "chat.send.request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ChatCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash"
        }
      },
      "required": [
        "chunk_id"
      ],
      "title": "ChatCitation",
      "type": "object"
    },
    "ChatDocument": {
      "additionalProperties": false,
      "properties": {
        "source_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "text": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source_name",
        "text"
      ],
      "title": "ChatDocument",
      "type": "object"
    },
    "ChatMode": {
      "enum": [
        "discuss",
        "draft",
        "edit",
        "images"
      ],
      "title": "ChatMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "chat.send 参数；同一账号/会话/请求标识仅受理一次，不把重放当重新生成。",
  "properties": {
    "conversation_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "text": {
      "default": "",
      "maxLength": 12000,
      "title": "Text",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ChatMode",
      "default": "discuss"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "References",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/ChatCitation"
      },
      "maxItems": 8,
      "title": "Citations",
      "type": "array"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/ChatDocument"
      },
      "maxItems": 3,
      "title": "Documents",
      "type": "array"
    },
    "selected_text": {
      "default": "",
      "maxLength": 8000,
      "title": "Selected Text",
      "type": "string"
    },
    "profile_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Id"
    },
    "clarification_message_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarification Message Id"
    },
    "clarification_answers": {
      "additionalProperties": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 3,
      "title": "Clarification Answers",
      "type": "object"
    },
    "retry_message_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Message Id"
    },
    "candidate_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "request_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "同一账号/会话内相同请求返回原消息；内容改变须使用新的请求标识",
      "title": "Request Id"
    }
  },
  "required": [
    "conversation_id"
  ],
  "title": "ChatSendRequest",
  "type": "object"
}
